{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/lib/api": [
        "./lib/api/index.ts"
      ],
      "@/lib/*": [
        "./lib/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "/Users/karen/MCSCaptsoneProject-frontend/.next-fresh/types/**/*.ts",
    "/Users/karen/MCSCaptsoneProject-frontend/.next-fresh/dev/types/**/*.ts",
    ".next-fresh/types/**/*.ts",
    ".next-fresh/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
