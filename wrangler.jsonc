{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mcscapstoneproject-frontend",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mcscapstoneproject-frontend"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    "preview": {
      "name": "mcscapstoneproject-frontend-preview",
      "ai": {
        "binding": "AI"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "mcscapstoneproject-frontend-preview"
        }
      ]
    }
  }
}