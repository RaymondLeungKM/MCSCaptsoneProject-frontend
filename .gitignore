# dependencies
/node_modules

# next.js
/.next/
/.next-*/
/.next-fresh/
/.open-next/
/out/
/Users/

# production
/build
/dist-validate/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
